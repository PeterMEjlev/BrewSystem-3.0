# Picovoice Access Key — get free at https://console.picovoice.ai/
PICOVOICE_ACCESS_KEY=your_picovoice_access_key_here

# OpenAI API Key — must have Realtime API access
OPENAI_API_KEY=sk-...

# Path to your custom "Bruce" wake word model (.ppn file)
# Platform-specific — pick the right one for your OS:
#   Windows:      Bruce_en_windows_v3_0_0.ppn
#   Linux/Pi:     Bruce_en_raspberry-pi_v3_0_0.ppn
WAKE_WORD_PATH=../Bruce-v2/wake-words/Bruce_en_windows_v3_0_0.ppn

# TTS voice for OpenAI Realtime (alloy | echo | fable | onyx | nova | shimmer)
BRUCE_VOICE=alloy

# System prompt (optional override)
# BRUCE_SYSTEM_PROMPT=You are Bruce, a helpful AI assistant for a home brewing setup.

# ── Talking to the BrewPlanner Pi ────────────────────────────────────────────
# The keys above configure the *local* Bruce that Electron starts (wake word +
# microphone, from ../Bruce-v2). Separately, this backend talks to the
# BrewPlanner web-server Pi for three things:
#
#   • Speaking. Announcements — notably a heater that isn't heating — go to the
#     Bruce wired to the brewery speaker, which runs over there.
#   • Brew sessions. The start menu's "Start a new brew session" reads
#     BrewPlanner's recipes and opens the row in its logbook.
#   • The brew day. When BrewPlanner has one in progress, the Recipe tab opens
#     straight into the recipe being brewed — and the app skips the start menu.
#
# Point this at that Pi's BrewPlanner server. Leave it unset and all three go
# quiet: the backend logs its announcements, the Recipe tab just shows the list,
# and the start menu offers the rig without a session.
# BREW_PLANNER_URL=http://192.168.3.3:3000

# Normally unnecessary: BrewPlanner lets any request from a private LAN address
# through as admin, and this rig is one. Set it only if that stops being true —
# TRUST_LOCAL=false on the web server, or the two Pis on different subnets. The
# value is a full-access token from BrewPlanner's /api/auth/login (its read-only
# WATCH_API_TOKEN is deliberately refused for control routes like speaking).
# BREW_PLANNER_TOKEN=
